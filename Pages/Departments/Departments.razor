@page "/departments"
@inject HttpClient Http
@using EmployesManagementSystemFront.Models
<h1 class="text-center mb-4">Departments</h1>
<a class="btn btn-primary mb-3" href="/departments/create">+ Add Department</a>

@if (departments == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in departments)
            {
                <tr>
                    <td>@d.Name</td>
                    <td>
                        <a class="btn btn-sm btn-warning" href="/departments/edit/@d.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" href="/departments/delete/@d.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<DepartamentResponce>? departments;

    protected override async Task OnInitializedAsync()
    {
        departments = await Http.GetFromJsonAsync<List<DepartamentResponce>>("http://localhost:5203/api/Department/GetAll");
    }
}
