@page "/departments/create"
@inject HttpClient Http
@inject NavigationManager Nav

<h1 class="mb-4">Create Department</h1>

<div class="mb-3">
    <label class="form-label">Department Name</label>
    <input class="form-control" @bind="name" />
</div>

<div class="d-flex gap-2">
    <button class="btn btn-primary" @onclick="CreateDepartment">Save</button>
    <a class="btn btn-outline-secondary" href="/departments">Cancel</a>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success mt-3">@message</div>
}

@code {
    private string name = "";
    private string message = "";

    private async Task CreateDepartment()
    {
        var content = new MultipartFormDataContent { { new StringContent(name), "name" } };
        var res = await Http.PostAsync("http://localhost:5203/api/Department/Create", content);

        if (res.IsSuccessStatusCode)
        {
            message = "✅ Department created successfully!";
            Nav.NavigateTo("/departments");
        }
        else
        {
            message = "❌ Failed to create department!";
        }
    }
}
